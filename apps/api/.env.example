# Kamutan API — example environment. NO real secrets here (SEC-24).
# Copy to .env (git-ignored) for local dev. In staging/prod, values live in Railway variables.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:3001
# Exact origins, comma-separated. No wildcard.
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# --- Auth: Supabase access tokens -----------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Legacy HS256 project JWT secret (Supabase dashboard → API → JWT secret). >= 32 chars.
SUPABASE_JWT_SECRET=
# Asymmetric signing keys: set JWT_USE_JWKS=true (URL derived from SUPABASE_URL) or SUPABASE_JWKS_URL.
JWT_USE_JWKS=false
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
# Defaults to ${SUPABASE_URL}/auth/v1
# JWT_ISSUER=

# --- Data -------------------------------------------------------------------
# pg = Postgres with RLS (role must be able to SET ROLE authenticated). memory = DB-less dev only.
DATA_DRIVER=pg
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# disable | require | verify-full  (production requires TLS)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Queue ------------------------------------------------------------------
# memory = no Redis needed (jobs are not consumed). bullmq = real queue (prod: rediss://).
QUEUE_DRIVER=memory
# REDIS_URL=redis://127.0.0.1:6379

# --- Storage ----------------------------------------------------------------
# local = files under STORAGE_LOCAL_DIR, uploads via PUT /v1/local-storage/:token (dev only).
# supabase = private bucket via service-role key (server-side only).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
STORAGE_BUCKET=drawings
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for upload tokens, >= 32 random chars (e.g. `openssl rand -base64 48`).
UPLOAD_TOKEN_SECRET=

# --- Rate limiting (per user, per instance) -------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
UPLOAD_THROTTLE_LIMIT=20
