# Kamutan API — example environment (Firebase, ADR 0008). NO secrets here (SEC-24).
# Copy to .env (git-ignored) for local runs. In Cloud Functions, plain values come from
# the deploy env and UPLOAD_TOKEN_SECRET from Secret Manager (defineSecret in src/function.ts).
#
# Credentials are NEVER configured here: firebase-admin / Pub/Sub use Application Default
# Credentials (the function's service account in GCP; locally `gcloud auth application-default login`
# or GOOGLE_APPLICATION_CREDENTIALS pointing to a key file kept OUTSIDE the repo).

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Empty = same-origin only (prod: Hosting rewrite /api/** → function api). For local Vite without a proxy:
CORS_ORIGINS=

GOOGLE_CLOUD_PROJECT=kamutan-fba67
FIREBASE_STORAGE_BUCKET=kamutan-fba67.firebasestorage.app

# firestore|memory, firebase|memory, pubsub|memory (memory = offline dev/tests; refused in production)
DATA_DRIVER=firestore
STORAGE_DRIVER=firebase
QUEUE_DRIVER=pubsub
INGEST_TOPIC=ingest

# HMAC secret for upload tokens, >= 32 random chars (e.g. `openssl rand -base64 48`).
UPLOAD_TOKEN_SECRET=

# Rate limiting (per user, per function instance)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
UPLOAD_THROTTLE_LIMIT=20
# tiles-manifest calls per user per window (each signs <= 256 URLs)
TILES_THROTTLE_LIMIT=60

# Signed artifact read URLs (tiles/thumbnail), seconds. Needs roles/iam.serviceAccountTokenCreator on the runtime SA.
SIGNED_URL_TTL_SECONDS=900

# Emulators (firebase-admin / Pub/Sub pick these up automatically):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
