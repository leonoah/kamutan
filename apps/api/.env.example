# Kamutan API — example environment. NO real secrets here (SEC-24).
# Copy to .env (git-ignored) for local dev. In staging/prod, values live in Railway variables.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:3001
# Exact origins, comma-separated. No wildcard.
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# --- Auth: Firebase ID tokens ---------------------------------------------
# Firebase console -> Project settings -> Project ID. Tokens are verified against Google's public keys.
FIREBASE_PROJECT_ID=
# Local dev/tests only (never production): HS256 secret for self-minted tokens, >= 32 chars.
# DEV_JWT_SECRET=

# --- Data -------------------------------------------------------------------
# firestore = Cloud Firestore (set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path,
# or FIRESTORE_EMULATOR_HOST=127.0.0.1:8080). memory = DB-less dev only.
DATA_DRIVER=firestore
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Queue ------------------------------------------------------------------
# memory = no Redis needed (jobs are not consumed). bullmq = real queue (prod: rediss://).
QUEUE_DRIVER=memory
# REDIS_URL=redis://127.0.0.1:6379

# --- Storage ----------------------------------------------------------------
# local = files under STORAGE_LOCAL_DIR, uploads via PUT /v1/local-storage/:token (dev only).
# firebase = private Firebase Storage bucket; the bucket needs a CORS rule allowing PUT from the web origin.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
# STORAGE_BUCKET=your-project.firebasestorage.app
# HMAC secret for upload tokens, >= 32 random chars (e.g. `openssl rand -base64 48`).
UPLOAD_TOKEN_SECRET=

# --- Rate limiting (per user, per instance) -------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
UPLOAD_THROTTLE_LIMIT=20
