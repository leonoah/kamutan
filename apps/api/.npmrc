# Read by the `npm install` that Cloud Build runs on the uploaded apps/api (Cloud Functions gen2), NOT by pnpm.
# Without it, npm 10.9 crashes while resolving devDependencies (vitest 4.x peer tree):
#   npm error Cannot read properties of null (reading 'edgesOut')
# The runtime (non-dev) dependency tree is unchanged: every peer we rely on is listed explicitly in package.json.
legacy-peer-deps=true
