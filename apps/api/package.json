{
  "name": "@kamutan/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kamutan Core API (NestJS)",
  "main": "dist/function.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node dist/main.js",
    "dev": "SWC_NODE_PROJECT=tsconfig.build.json node --watch -r @swc-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node dist/scripts/export-openapi.js",
    "test:emulator": "firebase emulators:exec --only firestore,storage,pubsub --project demo-kamutan \"vitest run test/integration\""
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22"
  }
}
