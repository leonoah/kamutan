{
  "name": "@kamutan/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kamutan Core API (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "SWC_NODE_PROJECT=tsconfig.build.json node --watch -r @swc-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@kamutan/contracts": "workspace:^",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "bullmq": "^5.34.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@nestjs/testing": "^10.4.15",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.4"
  }
}
