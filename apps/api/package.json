{
  "name": "@kamutan/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kamutan Core API (NestJS)",
  "main": "dist/function.js",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node dist/main.js",
    "dev": "SWC_NODE_PROJECT=tsconfig.build.json node --watch -r @swc-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node dist/scripts/export-openapi.js",
    "test:emulator": "firebase emulators:exec --only firestore,storage,pubsub --project demo-kamutan \"vitest run test/integration\""
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.2.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22"
  }
}
