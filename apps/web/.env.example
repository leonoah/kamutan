# Copy to .env.local for local overrides. Vite also reads .env.firebase automatically
# (see vite.config.ts), so the Firebase web config needs no copying.

# --- Firebase web app config (PUBLIC by design; security = Auth + Security Rules). Real values: .env.firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kamutan-fba67.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kamutan-fba67
VITE_FIREBASE_STORAGE_BUCKET=kamutan-fba67.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Analytics for Firebase stays OFF unless this is "true" (privacy default; consent UI later).
VITE_ANALYTICS_CONSENT=false

# Dev only: target of the Vite proxy for /api (the browser always calls same-origin /api/v1).
# e.g. the Functions emulator: http://127.0.0.1:5001/kamutan-fba67/europe-west1  or a local Nest: http://localhost:3000
VITE_API_URL=http://localhost:3000

# true = run fully standalone on the in-memory mock backend (no Firebase, no API).
VITE_USE_MOCKS=true
