# Supabase project (EU). Anon key only — never put the service role key in the web app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Kamutan REST API base (NestJS, /v1 is appended by the client)
VITE_API_URL=http://localhost:3000
# true = run fully standalone against the in-memory mock adapter (no Supabase / API needed)
VITE_USE_MOCKS=true
