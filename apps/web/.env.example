# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
# These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
# Kamutan REST API base (NestJS, /v1 is appended by the client)
VITE_API_URL=http://localhost:3001
# true = run fully standalone against the in-memory mock adapter (no Firebase / API needed)
VITE_USE_MOCKS=false
