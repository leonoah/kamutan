{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/worker-drawing.Dockerfile",
    "watchPatterns": ["workers/drawing/**", "infra/docker/worker-drawing.Dockerfile"]
  },
  "deploy": {
    "startCommand": "python -m kamutan_drawing",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": false
  }
}
