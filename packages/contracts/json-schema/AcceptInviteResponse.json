            "admin",
            "editor",
            "reviewer",
            "viewer"
          ]
        },
        "alreadyMember": {
          "type": "boolean"
        }
      },
      "required": [
        "orgId",
        "role",
        "alreadyMember"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/AcceptInviteResponse.json"
}
