{
  "$ref": "#/definitions/BoqBuild",
  "definitions": {
    "BoqBuild": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "jobId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "integer",
                  "minimum": 0
                },
                "green": {
                  "type": "integer",
                  "minimum": 0
                },
                "yellow": {
                  "type": "integer",
                  "minimum": 0
                },
                "red": {
                  "type": "integer",
                  "minimum": 0
                },
                "sheets": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence": {
                  "type": "integer",
                  "minimum": 0
                },
                "duplicatesRemoved": {
                  "type": "integer",
                  "minimum": 0
                },
                "unmapped": {
                  "type": "integer",
                  "minimum": 0
                },
                "calibration": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "conservative",
                        "full"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "mode",
                    "version"
                  ],
                  "additionalProperties": false
                },
                "coverage": {
                  "type": "object",
                  "properties": {
                    "libraryCodes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "produced": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "suggested": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "missing": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32,
                        "pattern": "^[0-9A-Za-z.\\-/]+$"
                      },
                      "maxItems": 500
                    },
                    "byChapter": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "libraryCodes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "produced": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "suggested": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "missing": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "libraryCodes",
                          "produced",
                          "suggested",
                          "missing"
                        ],
                        "additionalProperties": false
                      },
                      "propertyNames": {
                        "maxLength": 32
                      }
                    }
                  },
                  "required": [
                    "libraryCodes",
                    "produced",
                    "suggested",
                    "missing"
                  ],
                  "additionalProperties": true
                }
              },
              "required": [
                "lines",
                "green",
                "yellow",
                "red",
                "sheets",
                "evidence"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "message": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "type": "string",
          "enum": [
            "manual",
            "auto"
          ]
        },
        "debounceUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterBuildId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvalsInvalidated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lineId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "code": {
                "type": "string",
                "maxLength": 32
              },
              "fromQty": {
                "type": "number"
              },
              "toQty": {
                "type": "number"
              }
            },
            "required": [
              "lineId",
              "code",
              "fromQty",
              "toQty"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "approvalsAuditedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "status",
        "jobId",
        "requestedBy",
        "createdAt",
        "startedAt",
        "finishedAt",
        "stats",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqBuild.json"
}
