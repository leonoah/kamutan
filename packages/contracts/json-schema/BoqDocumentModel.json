{
  "$ref": "#/definitions/BoqDocumentModel",
  "definitions": {
    "BoqDocumentModel": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "kamutan.boq-document/1"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "templateId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "buildId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "split": {
              "type": "string",
              "enum": [
                "summed",
                "byFloor"
              ]
            },
            "includeConfidence": {
              "type": "boolean"
            },
            "chapters": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "markDraft": {
              "type": "boolean"
            }
          },
          "required": [
            "split",
            "includeConfidence",
            "chapters",
            "markDraft"
          ],
          "additionalProperties": false
        },
        "titleRows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "warning",
                  "title",
                  "draft"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "code",
                  "description",
                  "unit",
                  "qty",
                  "unitPrice",
                  "total",
                  "confidence",
                  "status"
                ]
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "key",
              "title",
              "width"
            ],
            "additionalProperties": false
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 32
              },
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "line",
                        "subtotal",
                        "note"
                      ]
                    },
                    "lineId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "code": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "qty": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "qtyFormat": {
                      "type": "string",
                      "enum": [
                        "general",
                        "decimal2"
                      ]
                    },
                    "price": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "total": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "level": {
                      "type": "string",
                      "enum": [
                        "green",
                        "yellow",
                        "red"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "reviewed",
                        "approved"
                      ]
                    },
                    "floor": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "needsInput": {
                      "type": "boolean"
                    },
                    "qtyOverridden": {
                      "type": "boolean"
                    },
                    "descriptionOverridden": {
                      "type": "boolean"
                    },
                    "cellNote": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 1000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "lineId",
                    "code",
                    "description",
                    "unit",
                    "qty",
                    "price",
                    "total"
                  ],
                  "additionalProperties": false
                }
              },
              "subtotal": {
                "type": "number"
              }
            },
            "required": [
              "code",
              "title",
              "notes",
              "rows",
              "subtotal"
            ],
            "additionalProperties": false
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "beforeVat": {
              "type": "number"
            },
            "vat": {
              "type": "number"
            },
            "afterVat": {
              "type": "number"
            },
            "vatRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "beforeVat",
            "vat",
            "afterVat",
            "vatRate"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "red",
                  "reapproval",
                  "unapproved",
                  "needsInput"
                ]
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "exportBlocked": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "green": {
              "type": "integer",
              "minimum": 0
            },
            "yellow": {
              "type": "integer",
              "minimum": 0
            },
            "red": {
              "type": "integer",
              "minimum": 0
            },
            "draft": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed": {
              "type": "integer",
              "minimum": 0
            },
            "approved": {
              "type": "integer",
              "minimum": 0
            },
            "overridden": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "lines",
            "green",
            "yellow",
            "red",
            "draft",
            "reviewed",
            "approved",
            "overridden"
          ],
          "additionalProperties": false
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema",
        "projectId",
        "templateId",
        "buildId",
        "options",
        "titleRows",
        "columns",
        "chapters",
        "totals",
        "warnings",
        "exportBlocked",
        "counts",
        "generatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqDocumentModel.json"
}
