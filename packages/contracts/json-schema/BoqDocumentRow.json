{
  "$ref": "#/definitions/BoqDocumentRow",
  "definitions": {
    "BoqDocumentRow": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "line",
            "subtotal",
            "note"
          ]
        },
        "lineId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "qtyFormat": {
          "type": "string",
          "enum": [
            "general",
            "decimal2"
          ]
        },
        "price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "priceSource": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "override",
                "library"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "unpriced": {
          "type": "boolean"
        },
        "level": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "floor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "needsInput": {
          "type": "boolean"
        },
        "qtyOverridden": {
          "type": "boolean"
        },
        "descriptionOverridden": {
          "type": "boolean"
        },
        "cellNote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "lineId",
        "code",
        "description",
        "unit",
        "qty",
        "price",
        "total"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqDocumentRow.json"
}
