{
  "$ref": "#/definitions/BoqEvidenceArtifact",
  "definitions": {
    "BoqEvidenceArtifact": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "kamutan.boq-evidence/1"
        },
        "buildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "lines": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sheetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "versionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "detectionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "linkGroupId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^lk_[A-Za-z0-9_-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "floor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "manual"
                  ]
                },
                "correctionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quantity": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "roomId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verified": {
                  "type": "boolean"
                }
              },
              "required": [
                "sheetId",
                "versionId",
                "detectionId",
                "linkGroupId",
                "floor"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          },
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "corrections": {
          "type": "object",
          "properties": {
            "applied": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "maxItems": 20000
            },
            "unmatched": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "correctionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "sheetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "versionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "correctionId",
                  "sheetId",
                  "versionId",
                  "reason"
                ],
                "additionalProperties": false
              },
              "maxItems": 20000
            }
          },
          "required": [
            "applied",
            "unmatched"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqEvidenceArtifact.json"
}
