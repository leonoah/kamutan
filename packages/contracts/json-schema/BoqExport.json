{
  "$ref": "#/definitions/BoqExport",
  "definitions": {
    "BoqExport": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "const": "xlsx"
        },
        "status": {
          "type": "string",
          "const": "ready"
        },
        "templateId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "split": {
          "type": "string",
          "enum": [
            "summed",
            "byFloor"
          ]
        },
        "markDraft": {
          "type": "boolean"
        },
        "storagePath": {
          "type": "string"
        },
        "buildId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "green": {
              "type": "integer",
              "minimum": 0
            },
            "yellow": {
              "type": "integer",
              "minimum": 0
            },
            "red": {
              "type": "integer",
              "minimum": 0
            },
            "draft": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed": {
              "type": "integer",
              "minimum": 0
            },
            "approved": {
              "type": "integer",
              "minimum": 0
            },
            "overridden": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "lines",
            "green",
            "yellow",
            "red",
            "draft",
            "reviewed",
            "approved",
            "overridden"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "templateId",
        "split",
        "markDraft",
        "storagePath",
        "buildId",
        "counts",
        "sha256",
        "sizeBytes",
        "createdBy",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqExport.json"
}
