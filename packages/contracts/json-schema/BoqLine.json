        "circuit": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "single",
                    "shared",
                    "two_way",
                    "cross",
                    "timer",
                    "no_switch"
