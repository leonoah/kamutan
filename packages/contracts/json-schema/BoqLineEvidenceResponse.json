{
  "$ref": "#/definitions/BoqLineEvidenceResponse",
  "definitions": {
    "BoqLineEvidenceResponse": {
      "type": "object",
      "properties": {
        "lineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "buildId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sheetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "versionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "detectionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "linkGroupId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^lk_[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "floor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "auto",
                  "manual"
                ]
              },
              "correctionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "roomId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "sheetId",
              "versionId",
              "detectionId",
              "linkGroupId",
              "floor"
            ],
            "additionalProperties": false
          }
        },
        "bySheet": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sheetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "versionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "floor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "count": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "sheetId",
              "versionId",
              "floor",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "linkGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sheetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "versionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "linkGroupId": {
                "type": "string",
                "maxLength": 128
              },
              "floor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "switchIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "pointIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "luminaireIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            },
            "required": [
              "sheetId",
              "versionId",
              "linkGroupId",
              "floor",
              "kind",
              "switchIds",
              "pointIds",
              "luminaireIds"
            ],
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "lineId",
        "buildId",
        "items",
        "bySheet",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqLineEvidenceResponse.json"
}
