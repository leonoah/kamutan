                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
