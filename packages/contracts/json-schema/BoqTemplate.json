{
  "$ref": "#/definitions/BoqTemplate",
  "definitions": {
    "BoqTemplate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 2000
                },
                "maxItems": 50
              },
              "codePrefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z]{1,8}$"
                },
                "maxItems": 8
              }
            },
            "required": [
              "code",
              "title",
              "notes"
            ],
            "additionalProperties": false
          },
          "maxItems": 60
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "enum": [
                  "code",
                  "description",
                  "unit",
                  "qty",
                  "unitPrice",
                  "total"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "width": {
                "type": "number",
                "minimum": 4,
                "maximum": 120
              }
            },
            "required": [
              "key",
              "title"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 6
        },
        "titleRows": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 10
        },
        "default": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "default",
            "import",
            "manual"
          ]
        },
        "sourceRef": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "vatRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "chapters",
        "columns",
        "titleRows",
        "default",
        "source",
        "vatRate",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqTemplate.json"
}
