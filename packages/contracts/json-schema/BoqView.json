{
  "$ref": "#/definitions/BoqView",
  "definitions": {
    "BoqView": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "latestBuildId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "builtAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stale": {
              "type": "boolean"
            },
            "staleReason": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "build": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "running",
                        "succeeded",
                        "failed"
                      ]
                    },
                    "jobId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "requestedBy": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "startedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "finishedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "stats": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "lines": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "green": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "yellow": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "red": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "sheets": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "evidence": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "duplicatesRemoved": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "unmapped": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "lines",
                            "green",
                            "yellow",
                            "red",
                            "sheets",
                            "evidence"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "error": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "message": {
                              "type": "string",
                              "maxLength": 2000
                            }
                          },
                          "required": [
                            "code",
                            "message"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidenceRef": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 1024
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "jobId",
                    "requestedBy",
                    "createdAt",
                    "startedAt",
                    "finishedAt",
                    "stats",
                    "error"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "counts": {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "integer",
                  "minimum": 0
                },
                "green": {
                  "type": "integer",
                  "minimum": 0
                },
                "yellow": {
                  "type": "integer",
                  "minimum": 0
                },
                "red": {
                  "type": "integer",
                  "minimum": 0
                },
                "draft": {
                  "type": "integer",
                  "minimum": 0
                },
                "reviewed": {
                  "type": "integer",
                  "minimum": 0
                },
                "approved": {
                  "type": "integer",
                  "minimum": 0
                },
                "overridden": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "lines",
                "green",
                "yellow",
                "red",
                "draft",
                "reviewed",
                "approved",
                "overridden"
              ],
              "additionalProperties": false
            },
            "floors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blockExportOnRed": {
              "type": "boolean"
            }
          },
          "required": [
            "latestBuildId",
            "builtAt",
            "stale",
            "staleReason",
            "build",
            "counts",
            "floors",
            "blockExportOnRed"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "chapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[0-9A-Za-z.\\-/]+$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "qty": {
                "type": "number"
              },
              "qtyOverride": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qtyOverrideReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qtyOverrideBy": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qtyOverrideAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 32
              },
              "floor": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lifecycle": {
                "type": "string",
                "enum": [
                  "existing",
                  "new",
                  "demolish"
                ]
              },
              "supply": {
                "type": "string",
                "enum": [
                  "contractor",
                  "client",
                  "existing"
                ]
              },
              "level": {
                "type": "string",
                "enum": [
                  "green",
                  "yellow",
                  "red"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 32
              },
              "evidenceRef": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "locked": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "reviewed",
                  "approved"
                ]
              },
              "reviewedBy": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "approvedBy": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "approvedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "byFloor": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "propertyNames": {
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              },
              "evidenceCount": {
                "type": "integer",
                "minimum": 0
              },
              "ruleId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceVersions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sheetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "versionId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  },
                  "required": [
                    "sheetId",
                    "versionId"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 500
              },
              "computedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "buildId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "chapter",
              "code",
              "description",
              "qty",
              "unit",
              "level",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "summary",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BoqView.json"
}
