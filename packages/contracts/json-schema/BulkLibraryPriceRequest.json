{
  "$ref": "#/definitions/BulkLibraryPriceRequest",
  "definitions": {
    "BulkLibraryPriceRequest": {
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "itemId",
              "amount"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 500
        }
      },
      "required": [
        "orgId",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/BulkLibraryPriceRequest.json"
}
