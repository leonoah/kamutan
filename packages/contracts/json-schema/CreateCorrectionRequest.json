{
  "$ref": "#/definitions/CreateCorrectionRequest",
  "definitions": {
    "CreateCorrectionRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "add",
            "remove",
            "reclassify",
            "move",
            "link",
            "unlink",
            "measure",
            "count",
            "accept",
            "reject"
          ]
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "anchorMm": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "radiusMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50,
          "default": 3
        },
        "detectionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "class": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "socket_single",
                "socket_double",
                "socket_triple",
                "socket_power",
                "socket_power_double",
                "socket_3phase",
                "socket_box_6",
                "socket_prep",
                "data_point",
                "tv_point",
                "phone_point",
                "speaker",
                "intercom",
                "doorbell",
                "heater_feed",
                "panel",
                "breaker",
                "switch_single",
                "switch_2way",
                "switch_fan",
                "luminaire_ceiling",
                "luminaire_wall",
                "luminaire_pendant",
                "luminaire_strip",
                "luminaire_outdoor",
                "ceiling_fan",
                "fixture_wc_concealed",
                "fixture_wc_monoblock",
                "fixture_basin",
                "faucet_basin",
                "faucet_wall",
                "fixture_shower",
                "fixture_bath",
                "fixture_kitchen_sink",
                "fixture_washing_machine",
                "garden_tap",
                "ac_unit",
                "room",
                "floor_tiling",
                "wall_cladding",
                "region",
                "note_point",
                "bezek_point",
                "waterproof_marker",
                "switch_cross",
                "switch_shutter",
                "conduit_cobra",
                "water_heater_feed",
                "legend_entry",
                "legend_box"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "itemCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[0-9A-Za-z.\\-/]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "linkGroupId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^lk_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "switchIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "maxItems": 16
        },
        "pointIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "maxItems": 64
        },
        "geometry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "point",
                    "polygon",
                    "polyline"
                  ]
                },
                "mm": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 2000
                }
              },
              "required": [
                "type",
                "mm"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "m2",
                "m",
                "unit"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "roomId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^r_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "floor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "sheetId",
        "versionId",
        "anchorMm"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/CreateCorrectionRequest.json"
}
