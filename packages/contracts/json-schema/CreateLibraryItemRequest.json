{
  "$ref": "#/definitions/CreateLibraryItemRequest",
  "definitions": {
    "CreateLibraryItemRequest": {
      "type": "object",
      "properties": {
        "orgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9A-Za-z.\\-/]+$"
        },
        "chapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "chapterTitle": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 32
        }
      },
      "required": [
        "orgId",
        "code",
        "chapter",
        "description",
        "unit"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/CreateLibraryItemRequest.json"
}
