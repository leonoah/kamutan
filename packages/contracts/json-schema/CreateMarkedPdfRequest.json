{
  "$ref": "#/definitions/CreateMarkedPdfRequest",
  "definitions": {
    "CreateMarkedPdfRequest": {
      "type": "object",
      "properties": {
        "sheetIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "minItems": 1,
              "maxItems": 200
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "type": "object",
          "properties": {
            "floorSplit": {
              "type": "boolean",
              "default": false
            },
            "watermark": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "hideTitleBlock": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/CreateMarkedPdfRequest.json"
}
