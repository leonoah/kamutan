{
  "$ref": "#/definitions/CreateShareLinkResponse",
  "definitions": {
    "CreateShareLinkResponse": {
      "type": "object",
      "properties": {
        "link": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "versionLock": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "revokedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "allowPdfDownload": {
              "type": "boolean"
            },
            "createdBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "versionLockBySheet": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "propertyNames": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "recipient": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "hideTitleBlock": {
              "type": "boolean"
            },
            "viewCount": {
              "type": "integer",
              "minimum": 0
            },
            "lastViewedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revokedBy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revokeReason": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "user",
                    "offboarding",
                    "project_deleted"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "pdfExportId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "titleBlockMaskedBySheet": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              },
              "propertyNames": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "includeUnmaskedSheets": {
              "type": "boolean"
            },
            "excludedSheets": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "propertyNames": {
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "boqSnapshotPath": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "state": {
              "type": "string",
              "enum": [
                "active",
                "expired",
                "revoked"
              ]
            },
            "shortId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "sheets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sheetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "versionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "titleBlockMasked": {
                    "type": "boolean"
                  },
                  "included": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sheetId",
                  "versionId",
                  "titleBlockMasked",
                  "included"
                ],
                "additionalProperties": false
              }
            },
            "boqLocked": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "versionLock",
            "expiresAt",
            "revokedAt",
            "allowPdfDownload",
            "createdBy",
            "createdAt",
            "versionLockBySheet",
            "label",
            "recipient",
            "hideTitleBlock",
            "viewCount",
            "lastViewedAt",
            "revokedBy",
            "revokeReason",
            "pdfExportId",
            "projectId",
            "state",
            "shortId",
            "sheets",
            "boqLocked"
          ],
          "additionalProperties": false
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "title_block_not_detected",
                  "title_block_not_detected_included"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "sheetIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              }
            },
            "required": [
              "code",
              "message",
              "sheetIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "link",
        "url",
        "token",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/CreateShareLinkResponse.json"
}
