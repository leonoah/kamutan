{
  "$ref": "#/definitions/CreateUploadResponse",
  "definitions": {
    "CreateUploadResponse": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "storagePath": {
          "type": "string"
        },
        "uploadToken": {
          "type": "string",
          "minLength": 16
        },
        "contentType": {
          "type": "string"
        },
        "fileKind": {
          "type": "string",
          "enum": [
            "pdf",
            "dwg",
            "dxf",
            "png"
          ]
        },
        "maxBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "fileId",
        "storagePath",
        "uploadToken",
        "contentType",
        "fileKind",
        "maxBytes",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/CreateUploadResponse.json"
}
