          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "deleted": {
          "type": "object",
          "properties": {
            "sheets": {
              "type": "integer",
              "minimum": 0
            },
            "versions": {
              "type": "integer",
              "minimum": 0
            },
            "docs": {
              "type": "integer",
              "minimum": 0
            },
            "objects": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "sheets",
            "versions",
            "docs",
            "objects"
          ],
          "additionalProperties": false
        },
