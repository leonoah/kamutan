        },
        "revokedShareLinks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sheetSetId",
        "deleted",
        "releasedBytes",
        "storageBytes",
        "storageQuotaBytes",
        "revokedShareLinks"
      ],
      "additionalProperties": false
