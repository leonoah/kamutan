{
  "$ref": "#/definitions/Detection",
  "definitions": {
    "Detection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^d_[A-Za-z0-9_-]+$"
        },
        "class": {
          "type": "string",
          "enum": [
            "socket_single",
            "socket_double",
            "socket_triple",
            "socket_power",
            "socket_power_double",
            "socket_3phase",
            "socket_box_6",
            "socket_prep",
            "data_point",
            "tv_point",
            "phone_point",
            "speaker",
            "intercom",
            "doorbell",
            "heater_feed",
            "panel",
            "breaker",
            "switch_single",
            "switch_2way",
            "switch_fan",
            "luminaire_ceiling",
            "luminaire_wall",
            "luminaire_pendant",
            "luminaire_strip",
            "luminaire_outdoor",
            "ceiling_fan",
            "fixture_wc_concealed",
            "fixture_wc_monoblock",
            "fixture_basin",
            "faucet_basin",
            "faucet_wall",
            "room",
            "floor_tiling",
            "wall_cladding",
            "region",
            "note_point",
            "bezek_point",
            "waterproof_marker",
            "switch_cross",
            "switch_shutter",
            "conduit_cobra",
            "water_heater_feed",
            "legend_entry",
            "legend_box",
            "unknown"
          ]
        },
        "legendEntryId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^le_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "centerMm": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "bboxMm": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number",
              "minimum": 0
            },
            "h": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "angleDeg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 16
        },
        "roomId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^r_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "floor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "existing",
            "new",
            "demolish",
            "unknown"
          ]
        },
        "supply": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "contractor",
                "client",
                "existing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "maxItems": 16
        },
        "clusterId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128,
              "pattern": "^u_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "class",
        "legendEntryId",
        "centerMm",
        "bboxMm",
        "angleDeg",
        "score",
        "level",
        "reasons",
        "roomId",
        "floor",
        "lifecycle",
        "supply",
        "annotations",
        "clusterId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/Detection.json"
}
