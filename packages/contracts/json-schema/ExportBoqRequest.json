{
  "$ref": "#/definitions/ExportBoqRequest",
  "definitions": {
    "ExportBoqRequest": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "split": {
          "type": "string",
          "enum": [
            "summed",
            "byFloor"
          ],
          "default": "summed"
        },
        "markDraft": {
          "type": "boolean",
          "default": false
        },
        "includeConfidence": {
          "type": "boolean",
          "default": true
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minItems": 1,
          "maxItems": 64
        },
        "includePrices": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/ExportBoqRequest.json"
}
