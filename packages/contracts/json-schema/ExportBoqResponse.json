            "lines": {
              "type": "integer",
              "minimum": 0
            },
            "green": {
              "type": "integer",
              "minimum": 0
            },
            "yellow": {
              "type": "integer",
              "minimum": 0
            },
            "red": {
              "type": "integer",
              "minimum": 0
            },
            "draft": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed": {
              "type": "integer",
              "minimum": 0
            },
            "approved": {
              "type": "integer",
              "minimum": 0
            },
            "overridden": {
              "type": "integer",
              "minimum": 0
