{
  "$ref": "#/definitions/FinalizeUploadResponse",
  "definitions": {
    "FinalizeUploadResponse": {
      "type": "object",
      "properties": {
        "sheetSet": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "orgId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "fileKind": {
              "type": "string",
              "enum": [
                "pdf",
                "dwg",
                "dxf",
                "png"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "storagePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "status": {
              "type": "string",
              "enum": [
                "uploaded",
                "splitting",
                "ready",
                "failed"
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "uploadedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "orgId",
            "projectId",
            "fileKind",
            "sha256",
            "storagePath",
            "status",
            "uploadedBy",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "sheet": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "logicalKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "discipline": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 50
              }
            },
            "floorRegions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "floor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "polygon": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "manual"
                    ]
                  }
                },
                "required": [
                  "floor",
                  "scale",
                  "polygon",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "scale": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "titleBlock": {
              "type": "object",
              "properties": {
                "sheetTitle": {
                  "type": "string"
                },
                "sheetNumber": {
                  "type": "string"
                },
                "discipline": {
                  "type": "string"
                },
                "scaleText": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "currentVersionId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sheetSetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "id",
            "logicalKey",
            "discipline",
            "floorRegions",
            "scale",
            "currentVersionId",
            "sheetSetId"
          ],
          "additionalProperties": false
        },
        "sheetVersion": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "sheetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "versionNo": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "uploaded",
                "queued",
                "processing",
                "ready",
                "failed"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pageIndex": {
              "type": "integer",
              "minimum": 0
            },
            "widthMm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heightMm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "artifacts": {
              "type": "object",
              "properties": {
                "primitives": {
                  "type": "string"
                },
                "tiles": {
                  "type": "string"
                },
                "detections": {
                  "type": "string"
                },
                "rooms": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "stats": {
              "type": "object",
              "properties": {
                "detections": {
                  "type": "integer"
                },
                "green": {
                  "type": "integer"
                },
                "yellow": {
                  "type": "integer"
                },
                "red": {
                  "type": "integer"
                },
                "rooms": {
                  "type": "integer"
                }
              },
              "required": [
                "detections",
                "green",
                "yellow",
                "red",
                "rooms"
              ],
              "additionalProperties": false
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "sheetId",
            "versionNo",
            "status",
            "sha256",
            "pageIndex",
            "artifacts",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "deduplicated": {
          "type": "boolean"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "sheetSet",
        "sheet",
        "sheetVersion",
        "deduplicated",
        "jobId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/FinalizeUploadResponse.json"
}
