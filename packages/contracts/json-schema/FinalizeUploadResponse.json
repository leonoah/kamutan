{
  "$ref": "#/definitions/FinalizeUploadResponse",
  "definitions": {
    "FinalizeUploadResponse": {
      "type": "object",
      "properties": {
        "sheetSet": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "orgId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "fileKind": {
              "type": "string",
              "enum": [
                "pdf",
                "dwg",
                "dxf",
                "png"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "storagePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "status": {
              "type": "string",
              "enum": [
                "uploaded",
                "queued",
                "splitting",
                "ready",
                "failed"
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "uploadedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            },
            "ingestJobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "versionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "pageCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "orgId",
            "projectId",
            "fileKind",
            "sha256",
            "storagePath",
            "status",
            "uploadedBy",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "deduplicated": {
          "type": "boolean"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "sheetSet",
        "deduplicated",
        "jobId",
        "versionId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/FinalizeUploadResponse.json"
}
