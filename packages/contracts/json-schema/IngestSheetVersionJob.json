{
  "$ref": "#/definitions/IngestSheetVersionJob",
  "definitions": {
    "IngestSheetVersionJob": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "type": {
          "type": "string",
          "const": "ingest.sheet_version"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "orgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sheetSetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "storagePath": {
          "type": "string",
          "pattern": "^orgs\\/([A-Za-z0-9_-]{1,128})\\/projects\\/([A-Za-z0-9_-]{1,128})\\/sources\\/([a-f0-9]{64})\\.(pdf|dwg|dxf|png)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileKind": {
          "type": "string",
          "enum": [
            "pdf",
            "dwg",
            "dxf",
            "png"
          ]
        },
        "traceparent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "jobId",
        "orgId",
        "projectId",
        "sheetSetId",
        "sheetId",
        "versionId",
        "storagePath",
        "sha256",
        "fileKind",
        "traceparent"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/IngestSheetVersionJob.json"
}
