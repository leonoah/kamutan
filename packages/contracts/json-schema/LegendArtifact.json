{
  "$ref": "#/definitions/LegendArtifact",
  "definitions": {
    "LegendArtifact": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "kamutan.legend/1"
        },
        "legends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^lg[A-Za-z0-9_-]+$"
              },
              "bboxMm": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 0
                  },
                  "h": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "bboxMm",
              "title",
              "confidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^le_[A-Za-z0-9_-]+$"
              },
              "legendId": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^lg[A-Za-z0-9_-]+$"
              },
              "symbolBboxMm": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 0
                  },
                  "h": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "labelBboxMm": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 0
                  },
                  "h": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "label": {
                "type": "string",
                "maxLength": 300
              },
              "labelConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "suggestedClass": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "socket_single",
                      "socket_double",
                      "socket_triple",
                      "socket_power",
                      "socket_power_double",
                      "socket_3phase",
                      "socket_box_6",
                      "socket_prep",
                      "data_point",
                      "tv_point",
                      "phone_point",
                      "speaker",
                      "intercom",
                      "doorbell",
                      "heater_feed",
                      "panel",
                      "breaker",
                      "switch_single",
                      "switch_2way",
                      "switch_fan",
                      "luminaire_ceiling",
                      "luminaire_wall",
                      "luminaire_pendant",
                      "luminaire_strip",
                      "luminaire_outdoor",
                      "ceiling_fan",
                      "fixture_wc_concealed",
                      "fixture_wc_monoblock",
                      "fixture_basin",
                      "faucet_basin",
                      "faucet_wall",
                      "fixture_shower",
                      "fixture_bath",
                      "fixture_kitchen_sink",
                      "fixture_washing_machine",
                      "garden_tap",
                      "ac_unit",
                      "room",
                      "floor_tiling",
                      "wall_cladding",
                      "region",
                      "note_point",
                      "bezek_point",
                      "waterproof_marker",
                      "switch_cross",
                      "switch_shutter",
                      "conduit_cobra",
                      "water_heater_feed",
                      "legend_entry",
                      "legend_box",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "classConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,128}$"
              },
              "thumb": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^legend\\/le_[A-Za-z0-9_-]{1,125}\\.webp$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "legendId",
              "symbolBboxMm",
              "labelBboxMm",
              "label",
              "labelConfidence",
              "suggestedClass",
              "classConfidence",
              "signature",
              "thumb"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schema",
        "legends",
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/LegendArtifact.json"
}
