{
  "$ref": "#/definitions/LibraryImport",
  "definitions": {
    "LibraryImport": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "orgId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "xls",
            "xlsx"
          ]
        },
        "storagePath": {
          "type": "string"
        },
        "originalName": {
          "type": "string",
          "maxLength": 255
        },
        "sizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_upload",
            "queued",
            "running",
            "succeeded",
            "failed",
            "rejected"
          ]
        },
        "jobId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "finalizedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "created": {
                  "type": "integer",
                  "minimum": 0
                },
                "updated": {
                  "type": "integer",
                  "minimum": 0
                },
                "templates": {
                  "type": "integer",
                  "minimum": 0
                },
                "ambiguousCodes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "maxItems": 1000
                },
                "templateName": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "created",
                "updated",
                "templates"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "message": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "orgId",
        "projectId",
        "sourceKind",
        "storagePath",
        "originalName",
        "sizeBytes",
        "status",
        "jobId",
        "createdBy",
        "createdAt",
        "expiresAt",
        "finalizedAt",
        "stats",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/LibraryImport.json"
}
