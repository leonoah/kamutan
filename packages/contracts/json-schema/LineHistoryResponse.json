{
  "$ref": "#/definitions/LineHistoryResponse",
  "definitions": {
    "LineHistoryResponse": {
      "type": "object",
      "properties": {
        "lineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "by": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "uid": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "displayName": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 200
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "uid",
                      "displayName"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "status",
                  "qtyOverride",
                  "note",
                  "rebuild",
                  "correction"
                ]
              },
              "before": {},
              "after": {},
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "at",
              "by",
              "action",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "lineId",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/LineHistoryResponse.json"
}
