{
  "$ref": "#/definitions/Member",
  "definitions": {
    "Member": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "editor",
            "reviewer",
            "viewer"
          ]
        },
        "email": {
          "type": "string",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "maxLength": 200
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "role",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/Member.json"
}
