{
  "$ref": "#/definitions/MissingItem",
  "definitions": {
    "MissingItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9A-Za-z.\\-/]+$"
        },
        "chapter": {
          "type": "string",
          "maxLength": 32
        },
        "chapterTitle": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "origin": {
          "type": "string",
          "enum": [
            "no_line",
            "zero_line"
          ]
        },
        "lineId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "itemId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "not_relevant"
          ]
        },
        "markKind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "measure_area",
                "measure_length",
                "count",
                "confirm"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "socket_single",
              "socket_double",
              "socket_triple",
              "socket_power",
              "socket_power_double",
              "socket_3phase",
              "socket_box_6",
              "socket_prep",
              "data_point",
              "tv_point",
              "phone_point",
              "speaker",
              "intercom",
              "doorbell",
              "heater_feed",
              "panel",
              "breaker",
              "switch_single",
              "switch_2way",
              "switch_fan",
              "luminaire_ceiling",
              "luminaire_wall",
              "luminaire_pendant",
              "luminaire_strip",
              "luminaire_outdoor",
              "ceiling_fan",
              "fixture_wc_concealed",
              "fixture_wc_monoblock",
              "fixture_basin",
              "faucet_basin",
              "faucet_wall",
              "fixture_shower",
              "fixture_bath",
              "fixture_kitchen_sink",
              "fixture_washing_machine",
              "garden_tap",
              "ac_unit",
              "room",
              "floor_tiling",
              "wall_cladding",
              "region",
              "note_point",
              "bezek_point",
              "waterproof_marker",
              "switch_cross",
              "switch_shutter",
              "conduit_cobra",
              "water_heater_feed",
              "legend_entry",
              "legend_box",
              "smoke_detector",
              "camera",
              "thermostat",
              "alarm_detector",
              "siren",
              "keypad",
              "shutter_feed",
              "ventilator_feed"
            ]
          },
          "maxItems": 32
        },
        "exclusion": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[0-9A-Za-z.\\-/]+$"
                },
                "description": {
                  "type": "string",
                  "maxLength": 2000
                },
                "unit": {
                  "type": "string",
                  "maxLength": 32
                },
                "chapter": {
                  "type": "string",
                  "maxLength": 32
                },
                "active": {
                  "type": "boolean"
                },
                "excludedBy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "excludedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "restoredBy": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "restoredAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "code",
                "description",
                "unit",
                "chapter",
                "active",
                "excludedBy",
                "excludedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "code",
        "chapter",
        "chapterTitle",
        "description",
        "unit",
        "origin",
        "lineId",
        "itemId",
        "state",
        "markKind",
        "classes",
        "exclusion"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/MissingItem.json"
}
