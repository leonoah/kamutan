{
  "$ref": "#/definitions/OverlayManifest",
  "definitions": {
    "OverlayManifest": {
      "type": "object",
      "properties": {
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "legend": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "detections": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "rooms": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "thumbs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          },
          "propertyNames": {
            "pattern": "^(le|u)_[A-Za-z0-9_-]+$"
          }
        },
        "stats": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "paths": {
                  "type": "integer",
                  "minimum": 0
                },
                "segments": {
                  "type": "integer",
                  "minimum": 0
                },
                "textLines": {
                  "type": "integer",
                  "minimum": 0
                },
                "glyphs": {
                  "type": "integer",
                  "minimum": 0
                },
                "detections": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "green": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "yellow": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "red": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unknown": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "byClass": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "propertyNames": {
                        "maxLength": 64
                      }
                    }
                  },
                  "required": [
                    "total",
                    "green",
                    "yellow",
                    "red",
                    "unknown",
                    "byClass"
                  ],
                  "additionalProperties": false
                },
                "rooms": {
                  "type": "integer",
                  "minimum": 0
                },
                "legendEntries": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "paths",
                "segments",
                "textLines",
                "glyphs"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sheetId",
        "versionId",
        "legend",
        "detections",
        "rooms",
        "thumbs",
        "stats",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/OverlayManifest.json"
}
