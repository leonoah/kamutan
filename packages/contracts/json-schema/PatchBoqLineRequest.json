{
  "$ref": "#/definitions/PatchBoqLineRequest",
  "definitions": {
    "PatchBoqLineRequest": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "qtyOverride": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "allOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "alsoUpdateLibrary": {
          "type": "boolean"
        },
        "priceOverride": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
