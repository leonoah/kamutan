{
  "$ref": "#/definitions/PatchBoqLineResponse",
  "definitions": {
    "PatchBoqLineResponse": {
      "type": "object",
      "properties": {
        "line": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "chapter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[0-9A-Za-z.\\-/]+$"
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "qty": {
              "type": "number"
            },
            "qtyOverride": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "qtyOverrideReason": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "qtyOverrideBy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "qtyOverrideAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "type": "string",
              "maxLength": 32
            },
            "floor": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "lifecycle": {
              "type": "string",
              "enum": [
                "existing",
                "new",
                "demolish"
              ]
            },
            "supply": {
              "type": "string",
              "enum": [
                "contractor",
                "client",
                "existing"
              ]
            },
            "level": {
              "type": "string",
              "enum": [
                "green",
                "yellow",
                "red"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 32
            },
            "evidenceRef": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "locked": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "reviewed",
                "approved"
              ]
            },
            "reviewedBy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approvedBy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "approvedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "byFloor": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "propertyNames": {
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            },
            "evidenceCount": {
              "type": "integer",
              "minimum": 0
            },
            "ruleId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceVersions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sheetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "versionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                },
                "required": [
                  "sheetId",
                  "versionId"
                ],
                "additionalProperties": false
              },
              "maxItems": 500
            },
            "computedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "buildId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "orderQty": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "wasteFactor": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.5
                },
                {
                  "type": "null"
                }
              ]
            },
            "manualCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "chapter",
            "code",
            "description",
            "qty",
            "unit",
            "level",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "line"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/PatchBoqLineResponse.json"
}
