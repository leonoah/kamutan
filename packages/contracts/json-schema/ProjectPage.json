{
  "$ref": "#/definitions/ProjectPage",
  "definitions": {
    "ProjectPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "orgId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "address": {
                "type": "string",
                "maxLength": 500
              },
              "templateId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "floors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "sortOrder": {
                      "type": "integer"
                    },
                    "elevationM": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "code",
                    "name",
                    "sortOrder"
                  ],
                  "additionalProperties": false
                }
              },
              "stats": {
                "type": "object",
                "properties": {
                  "sheets": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reviewOpen": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "boqLines": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "red": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "yellow": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "green": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "sheets",
                  "reviewOpen",
                  "boqLines",
                  "red",
                  "yellow",
                  "green"
                ],
                "additionalProperties": false
              },
              "boq": {
                "type": "object",
                "properties": {
                  "latestBuildId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "builtAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stale": {
                    "type": "boolean"
                  },
                  "pendingBuildId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "staleReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "staleAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "latestBuildId",
                  "builtAt",
                  "stale"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "archived"
                ]
              },
              "createdBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "orgId",
              "name",
              "floors",
              "status",
              "createdBy",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/ProjectPage.json"
}
