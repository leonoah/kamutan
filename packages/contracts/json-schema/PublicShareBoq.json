{
  "$ref": "#/definitions/PublicShareBoq",
  "definitions": {
    "PublicShareBoq": {
      "type": "object",
      "properties": {
        "snapshotAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "chapter": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "qty": {
                "type": "number"
              },
              "level": {
                "type": "string",
                "enum": [
                  "green",
                  "yellow",
                  "red"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "reviewed",
                  "approved"
                ]
              },
              "floor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "byFloor": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "descriptionManual": {
                "type": "boolean"
              },
              "unitPrice": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "total": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "chapter",
              "code",
              "description",
              "unit",
              "qty",
              "level",
              "status",
              "floor",
              "byFloor"
            ],
            "additionalProperties": false
          }
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "integer"
            },
            "green": {
              "type": "integer"
            },
            "yellow": {
              "type": "integer"
            },
            "red": {
              "type": "integer"
            },
            "approved": {
              "type": "integer"
            }
          },
          "required": [
            "lines",
            "green",
            "yellow",
            "red",
            "approved"
          ],
          "additionalProperties": false
        },
        "showPrices": {
          "type": "boolean"
        },
        "totals": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "enum": [
                    "ILS"
                  ]
                },
                "linesTotal": {
                  "type": "number"
                },
                "adjustmentPct": {
                  "type": "number"
                },
                "adjustment": {
                  "type": "number"
                },
                "beforeVat": {
                  "type": "number"
                },
                "vat": {
                  "type": "number"
                },
                "afterVat": {
                  "type": "number"
                },
                "vatRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "pricedLines": {
                  "type": "integer",
                  "minimum": 0
                },
                "unpricedLines": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "currency",
                "linesTotal",
                "adjustmentPct",
                "adjustment",
                "beforeVat",
                "vat",
                "afterVat",
                "vatRate",
                "pricedLines",
                "unpricedLines"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "snapshotAt",
        "lines",
        "floors",
        "counts"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/PublicShareBoq.json"
}
