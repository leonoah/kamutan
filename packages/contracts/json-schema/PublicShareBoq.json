            "additionalProperties": false
          }
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "integer"
            },
            "green": {
              "type": "integer"
            },
            "yellow": {
              "type": "integer"
            },
            "red": {
              "type": "integer"
            },
            "approved": {
              "type": "integer"
            }
          },
          "required": [
            "lines",
            "green",
            "yellow",
            "red",
            "approved"
          ],
          "additionalProperties": false
        }
