{
  "$ref": "#/definitions/QuickMeasureRequest",
  "definitions": {
    "QuickMeasureRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "measure_area",
            "measure_length",
            "count",
            "confirm"
          ]
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "geometry": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "point",
                "polygon",
                "polyline"
              ]
            },
            "mm": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 2000
            }
          },
          "required": [
            "type",
            "mm"
          ],
          "additionalProperties": false
        },
        "quantity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "sheetId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/QuickMeasureRequest.json"
}
