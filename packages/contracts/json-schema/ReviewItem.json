{
  "$ref": "#/definitions/ReviewItem",
  "definitions": {
    "ReviewItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "level": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "clusterId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "dismissed"
          ]
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "targetRef": {
          "type": "string",
          "maxLength": 128
        },
        "riskScore": {
          "type": "number"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "level",
        "reasons",
        "clusterId",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/ReviewItem.json"
}
