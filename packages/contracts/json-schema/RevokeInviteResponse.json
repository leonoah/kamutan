{
  "$ref": "#/definitions/RevokeInviteResponse",
  "definitions": {
    "RevokeInviteResponse": {
      "type": "object",
      "properties": {
        "invite": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "orgId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "email": {
              "type": "string",
              "maxLength": 320
            },
            "role": {
              "type": "string",
              "enum": [
                "admin",
                "editor",
                "reviewer",
                "viewer"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "revoked"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "revoked",
                "expired"
              ]
            },
            "invitedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "acceptedBy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "acceptedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revokedBy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revokedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "orgId",
            "email",
            "role",
            "status",
            "state",
            "invitedBy",
            "createdAt",
            "expiresAt"
          ],
          "additionalProperties": false
