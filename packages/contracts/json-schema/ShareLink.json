{
  "$ref": "#/definitions/ShareLink",
  "definitions": {
    "ShareLink": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "tokenHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "versionLock": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowPdfDownload": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tokenHash",
        "versionLock",
        "expiresAt",
        "revokedAt",
        "allowPdfDownload",
        "createdBy",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/ShareLink.json"
}
