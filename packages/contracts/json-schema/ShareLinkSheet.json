        "versionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "titleBlockMasked": {
          "type": "boolean"
        },
        "included": {
          "type": "boolean"
        }
      },
