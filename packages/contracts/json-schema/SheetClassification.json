{
  "$ref": "#/definitions/SheetClassification",
  "definitions": {
    "SheetClassification": {
      "type": "object",
      "properties": {
        "discipline": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,39}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "floors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "maxItems": 16
        },
        "sheetTitle": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "scaleText": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "green",
            "yellow",
            "red"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 32
        }
      },
      "required": [
        "discipline",
        "floors",
        "sheetTitle",
        "scaleText",
        "confidence",
        "level",
        "reasons"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/SheetClassification.json"
}
