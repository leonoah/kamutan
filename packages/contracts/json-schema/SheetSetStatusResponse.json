{
  "$ref": "#/definitions/SheetSetStatusResponse",
  "definitions": {
    "SheetSetStatusResponse": {
      "type": "object",
      "properties": {
        "sheetSet": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "orgId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "fileKind": {
              "type": "string",
              "enum": [
                "pdf",
                "dwg",
                "dxf",
                "png"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "storagePath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "status": {
              "type": "string",
              "enum": [
                "uploaded",
                "queued",
                "splitting",
                "ready",
                "failed"
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "uploadedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            },
            "storageBytes": {
              "type": "integer",
              "minimum": 0
            },
            "ingestJobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "versionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "pageCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "error": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "message": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "replacesSheetSetId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "supersededBySetId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "supersededAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "supersede": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "matched"
                      ]
                    },
                    "matchedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sheetMap": {
                      "type": "object",
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9_-]+$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "orgId",
            "projectId",
            "fileKind",
            "sha256",
            "storagePath",
            "status",
            "uploadedBy",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "job": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued",
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled"
                  ]
                },
                "progress": {
                  "type": "object",
                  "properties": {
                    "stage": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "stage",
                    "pct"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "status",
                "progress"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 64
                },
                "message": {
                  "type": "string",
                  "maxLength": 2000
                },
                "messageHe": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "messageHe"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "infected": {
          "type": "boolean"
        }
      },
      "required": [
        "sheetSet",
        "job",
        "error",
        "infected"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/SheetSetStatusResponse.json"
}
