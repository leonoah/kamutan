{
  "$ref": "#/definitions/SheetVersion",
  "definitions": {
    "SheetVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "versionNo": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "uploaded",
            "queued",
            "processing",
            "ready",
            "failed"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "primitives": {
              "type": "string"
            },
            "tiles": {
              "type": "string"
            },
            "detections": {
              "type": "string"
            },
            "rooms": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "stats": {
          "type": "object",
          "properties": {
            "detections": {
              "type": "integer"
            },
            "green": {
              "type": "integer"
            },
            "yellow": {
              "type": "integer"
            },
            "red": {
              "type": "integer"
            },
            "rooms": {
              "type": "integer"
            }
          },
          "required": [
            "detections",
            "green",
            "yellow",
            "red",
            "rooms"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sheetId",
        "versionNo",
        "status",
        "sha256",
        "pageIndex",
        "artifacts",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/SheetVersion.json"
}
