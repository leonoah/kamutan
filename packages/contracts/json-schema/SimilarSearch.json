{
  "$ref": "#/definitions/SimilarSearch",
  "definitions": {
    "SimilarSearch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "exemplar": {
          "type": "object",
          "properties": {
            "sheetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "versionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "bboxMm": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "additionalProperties": false
            },
            "class": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "socket_single",
                    "socket_double",
                    "socket_triple",
                    "socket_power",
                    "socket_power_double",
                    "socket_3phase",
                    "socket_box_6",
                    "socket_prep",
                    "data_point",
                    "tv_point",
                    "phone_point",
                    "speaker",
                    "intercom",
                    "doorbell",
                    "heater_feed",
                    "panel",
                    "breaker",
                    "switch_single",
                    "switch_2way",
                    "switch_fan",
                    "luminaire_ceiling",
                    "luminaire_wall",
                    "luminaire_pendant",
                    "luminaire_strip",
                    "luminaire_outdoor",
                    "ceiling_fan",
                    "fixture_wc_concealed",
                    "fixture_wc_monoblock",
                    "fixture_basin",
                    "faucet_basin",
                    "faucet_wall",
                    "fixture_shower",
                    "fixture_bath",
                    "fixture_kitchen_sink",
                    "fixture_washing_machine",
                    "garden_tap",
                    "ac_unit",
                    "room",
                    "floor_tiling",
                    "wall_cladding",
                    "region",
                    "note_point",
                    "bezek_point",
                    "waterproof_marker",
                    "switch_cross",
                    "switch_shutter",
                    "conduit_cobra",
                    "water_heater_feed",
                    "legend_entry",
                    "legend_box"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "sheetId",
            "versionId",
            "bboxMm",
            "class"
          ],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "enum": [
            "sheet",
            "project"
          ]
        },
        "correctionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "jobId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^c_[A-Za-z0-9_-]{1,64}$"
              },
              "sheetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "versionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "centerMm": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "bboxMm": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 0
                  },
                  "h": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "alreadyDetected": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "currentClass": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "thumb": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^c_[A-Za-z0-9_-]{1,64}\\.webp$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "sheetId",
              "versionId",
              "centerMm",
              "bboxMm",
              "score",
              "alreadyDetected",
              "currentClass",
              "thumb"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "thumbs": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 64
                },
                "message": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "status",
        "exemplar",
        "scope",
        "correctionId",
        "jobId",
        "requestedBy",
        "createdAt",
        "finishedAt",
        "candidates",
        "thumbs",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/SimilarSearch.json"
}
