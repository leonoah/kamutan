{
  "$ref": "#/definitions/TextItemsArtifact",
  "definitions": {
    "TextItemsArtifact": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "kamutan.textItems/1"
        },
        "sheetId": {
          "type": "string",
          "maxLength": 128
        },
        "discipline": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogVersion": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^t_[A-Za-z0-9_-]+$"
              },
              "sheetId": {
                "type": "string",
                "maxLength": 128
              },
              "kind": {
                "type": "string",
                "enum": [
                  "note",
                  "callout",
                  "detail_ref",
                  "legend_row",
                  "panel_schedule",
                  "conduit"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 1000
              },
              "normalized": {
                "type": "string",
                "maxLength": 1000
              },
              "bboxMm": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "minimum": 0
                  },
                  "h": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "anchorMm": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lineIdx": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxItems": 256
              },
              "floor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "roomId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lifecycle": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "new",
                      "existing",
                      "replace",
                      "add",
                      "demolish"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qty": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lengthM": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "matchedPattern": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "itemCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "item",
                      "feed",
                      "switch"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pairedWith": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "corroborates": {
                "type": "boolean"
              },
              "suggested": {
                "type": "boolean"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scoreRaw": {
                "type": "number"
              },
              "level": {
                "type": "string",
                "enum": [
                  "green",
                  "yellow",
                  "red"
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 16
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "bboxMm",
              "confidence",
              "level",
              "reasons"
            ],
            "additionalProperties": true
          },
          "maxItems": 20000
        },
        "stats": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "schema",
        "items"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/TextItemsArtifact.json"
}
