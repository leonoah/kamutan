{
  "$ref": "#/definitions/TilesArtifact",
  "definitions": {
    "TilesArtifact": {
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "format": {
          "type": "string",
          "const": "webp"
        },
        "tileSize": {
          "type": "number",
          "const": 256
        },
        "dpi": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1200
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "widthPx": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "heightPx": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "prefix",
        "format",
        "tileSize",
        "dpi",
        "levels",
        "widthPx",
        "heightPx"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kamutan.app/schemas/TilesArtifact.json"
}
