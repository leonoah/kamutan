        "key": "description",
        "title": "תאור העבודה",
        "width": 60
      },
      {
        "key": "unit",
        "title": "יחידה",
        "width": 10
      },
      {
        "key": "qty",
        "title": "כמות",
        "width": 11
      },
      {
        "key": "unitPrice",
        "title": "מחיר יח'",
        "width": 11
      },
      {
        "key": "total",
        "title": "סה\"כ ₪",
        "width": 14
      }
    ],
    "chapters": [
      {
        "code": "01",
        "title": "פרק 01 – עבודות הריסה ופינוי",
        "notes": [
          "1. העבודות כוללות פינוי הפסולת לאתר מורשה.",
          "2. ההריסות יבוצעו לפי תכנית ההריסה בלבד."
        ],
        "codePrefixes": [
          "1"
        ]
      },
      {
        "code": "03",
        "title": "פרק 03 – עבודות אינסטלציה",
        "notes": [
          "1. העבודות כוללות חיבור לצנרת הקיימת ובדיקת לחץ.",
          "2. הכמויות לפי תכניות האינסטלציה המצורפות."
        ],
        "codePrefixes": [
          "3"
        ]
      },
      {
        "code": "04",
        "title": "פרק 04 – עבודות חשמל",
        "notes": [
          "1. כל העבודות יבוצעו על ידי חשמלאי מוסמך ולפי התקנים המחייבים.",
          "2. הכמויות לפי תכניות החשמל המצורפות."
        ],
        "codePrefixes": [
          "4"
        ]
      },
      {
        "code": "05",
        "title": "פרק 05 – עבודות ריצוף, חיפוי ואיטום",
        "notes": [
          "1. הכמויות במ\"ר / מ\"א לפי מידות התכנית; הפחת מפורט בעמודת כמות ההזמנה.",
          "2. האיטום יבוצע לפני הריצוף והחיפוי."
        ],
        "codePrefixes": [
          "5"
        ]
      },
      {
        "code": "09",
        "title": "פרק 09 – תאורה",
        "notes": [
          "1. התקנת גופי תאורה לפי תכנית התאורה המצורפת."
        ],
        "codePrefixes": [
          "9"
        ]
      }
    ]
  },
