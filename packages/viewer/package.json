{
  "name": "@kamutan/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Kamutan drawing viewer: Deck.gl 9 orthographic tiled sheet viewer with paper-mm overlays, picking, lasso, measure and scale calibration",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./math": {
      "types": "./src/math/index.ts",
      "default": "./src/math/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@deck.gl/widgets": "9.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
